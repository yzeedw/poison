end

local function HandleInfPrompt(prompt)
	local character = LocalPlayer.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local lockpick = character:FindFirstChild("Lockpick") or character:FindFirstChild("SkeletonKey")
		or character:FindFirstChild("Shears") or character:FindFirstChild("Multitool")
	local toolName = lockpick and lockpick.Name
	if lockpick and InfiniteItemsSelected then
		local keyMap = {Lockpick="lockpick",SkeletonKey="skeleton key",Shears="shears",Multitool="multitool"}
		local selectedKey = keyMap[lockpick.Name]
		if selectedKey and not InfiniteItemsSelected[selectedKey] then return end
	end
	local parentPart = prompt.Parent and (prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart"))
	local dist = parentPart and Distance(parentPart.Position) or 999
	if lockpick and dist <= prompt.MaxActivationDistance + 5 then
		if prompt:GetAttribute("InfItems") and prompt:GetAttribute("Tool") ~= toolName then RestorePrompt(prompt) end
		if prompt:GetAttribute("InfItems") then
			local infTime = prompt:GetAttribute("InfTime")
			if tick() - (infTime or 0) > 8 or dist > prompt.MaxActivationDistance + 7 then RestorePrompt(prompt) end
			return
		end
		prompt.Enabled = false
		prompt:SetAttribute("InfItems", true)
		prompt:SetAttribute("Tool", toolName)
		prompt:SetAttribute("InfTime", tick())
		prompt.ClickablePrompt = false
		local infPrompt = prompt:Clone()
		infPrompt.Name, infPrompt.MaxActivationDistance = "InfPrompt", prompt.MaxActivationDistance
		infPrompt.Parent, infPrompt.Enabled, infPrompt.ClickablePrompt = prompt.Parent, true, true
		local connect2, connect3, cleanupFn
		cleanupFn = function()
			if connect2 then connect2:Disconnect() end
			if connect3 then connect3:Disconnect() end
			RestorePrompt(prompt)
		end
		connect3 = infPrompt.PromptButtonHoldEnded:Connect(function()
			task.delay(0.15, function()
				if infPrompt and infPrompt.Parent then cleanupFn() end
			end)
		end)
		connect2 = infPrompt.Triggered:Connect(function()
			if connect3 then connect3:Disconnect() end
			if connect2 then connect2:Disconnect() end
			if infPrompt and infPrompt.Parent then infPrompt:Destroy() end
			if character:FindFirstChild(toolName) then
				task.spawn(function()
					local startTick = tick()
					local droppedTool, isFinished
					repeat
						local dropRemote = EntityInfo:FindFirstChild("DropItem") or RemotesFolder:FindFirstChild("DropItem")
						if dropRemote then dropRemote:FireServer(lockpick) end
						task.wait(0.01)
						local searchDist = 15
						if workspace:FindFirstChild("Drops") then
							for _, dropObj in ipairs(workspace.Drops:GetChildren()) do
								if dropObj.Name == toolName then
									local d = Distance(dropObj:GetPivot().Position)
									if d < searchDist then droppedTool, searchDist = dropObj, d end
								end
							end
						end
						isFinished = droppedTool or not character:FindFirstChild(toolName) or (tick() - startTick > 2.5)
					until isFinished
					local fireFunc = fireproximityprompt
					if toolName == "Shears" then
						if fireFunc then fireFunc(prompt) end
						if droppedTool then
							local sp = droppedTool:FindFirstChildWhichIsA("ProximityPrompt", true)
							if sp and fireFunc then fireFunc(sp) end
						end
					else
						if droppedTool then
							local sp = droppedTool:FindFirstChildWhichIsA("ProximityPrompt", true)
							if sp and fireFunc then fireFunc(sp) end
						end
						if fireFunc then fireFunc(prompt) end
					end
					RestorePrompt(prompt)
				end)
			else
				RestorePrompt(prompt)
			end
		end)
		return
	end
	if prompt:GetAttribute("InfItems") then RestorePrompt(prompt) end
end

