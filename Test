local function giggleLogic()
	local function removeHitbox(model)
		for _, part in ipairs(model:GetDescendants()) do
			if part.Name == "Hitbox" then part:Destroy() end
		end
	end
	for _, model in ipairs(Workspace:GetDescendants()) do
		if model.Name == "GiggleCeiling" then removeHitbox(model) end
	end
	Workspace.DescendantAdded:Connect(function(d)
		if not states.giggleRemover then return end
		if d.Name == "GiggleCeiling" then
			removeHitbox(d)
		elseif d.Name == "Hitbox" then
			local p = d.Parent
			while p do
				if p.Name == "GiggleCeiling" then d:Destroy(); break end
				p = p.Parent
			end
		end
	end)
end
