local function getLatestRoomNumber()
	local gd = ReplicatedStorage:FindFirstChild("GameData")
	return gd and gd:FindFirstChild("LatestRoom") and gd.LatestRoom.Value or 0
end

local function isOnScreen(part)
	if not part or not part:IsA("BasePart") then return false end
	local _, visible = camera:WorldToViewportPoint(part.Position)
	return visible
end

local function isPartInSkippedRoom(part)
	if not ESPOptimized or not part then return false end
	local latestRoom = getLatestRoomNumber()
	local currentRooms = Workspace:FindFirstChild("CurrentRooms")
	if currentRooms then
		for _, room in ipairs(currentRooms:GetChildren()) do
			local rn = tonumber(room.Name)
			if rn and rn < (latestRoom - 1) and part:IsDescendantOf(room) then return true end
		end
	end
	if (ESPOptimizationMethod == "onscreen" or ESPOptimizationMethod == "onScreen") and not isOnScreen(part) then return true end
	return false
end

local function getRoomsToScan(currentRooms)
	if not ESPOptimized then return currentRooms:GetChildren() end
	local latestRoom = getLatestRoomNumber()
	local validRooms = {}
	for _, room in ipairs(currentRooms:GetChildren()) do
		local rn = tonumber(room.Name)
		if not rn or rn >= (latestRoom - 1) then table.insert(validRooms, room) end
	end
	return validRooms
end

