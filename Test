local function updateESP()
	while true do
		local currentRooms = Workspace:FindFirstChild("CurrentRooms")
		if currentRooms then
			if ESPDoors then
				pruneTracked(trackedDoors)
				for _, room in ipairs(currentRooms:GetChildren()) do
					if ESPOptimized and not isLatestRoom(room) then continue end
					local door = room:FindFirstChild("Door")
					if door and door.PrimaryPart and not ActiveESP[door.PrimaryPart] then
						ApplyESP(door.PrimaryPart, Color3.fromRGB(100,255,100), "door " .. ((tonumber(room.Name) or 0) + 1))
						table.insert(trackedDoors, door.PrimaryPart)
					end
				end
			end
			pcall(findItems, currentRooms)
			pcall(findBooks, currentRooms)
			pcall(findFigure, currentRooms)
			pcall(findWardrobes, currentRooms)
			pcall(findKeys, currentRooms)
			pcall(findLevers, currentRooms)
		end
		if ESPMonsters then
			pruneTracked(trackedMonsters)
			for _, child in ipairs(workspace:GetChildren()) do
				if child:IsA("Model") and Entities[child.Name] then
					local part = child.PrimaryPart or child:FindFirstChild("HumanoidRootPart") or child:FindFirstChild("Hitbox") or child:FindFirstChildWhichIsA("BasePart")
					if part and part:IsA("BasePart") and not ActiveESP[part] then
						ApplyESP(part, Color3.fromRGB(255, 0, 0), (Entities[child.Name].Alias or child.Name):lower())
						table.insert(trackedMonsters, part)
					end
				end
			end
		end
		if ESPPlayers then
			pruneTracked(trackedPlayers)
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character.PrimaryPart and not ActiveESP[p.Character.PrimaryPart] then
					ApplyESP(p.Character.PrimaryPart, Color3.fromRGB(0,255,255), p.Name:lower())
					table.insert(trackedPlayers, p.Character.PrimaryPart)
				end
			end
		end
		task.wait(0.5)
	end
end
