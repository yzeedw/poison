local function CreateToggleObject()
	local obj = {Value = false, Listeners = {}}
	function obj:OnChanged(func)
		table.insert(obj.Listeners, func)
	end
	function obj:SetValue(val)
		obj.Value = val
		for _, f in ipairs(obj.Listeners) do
			task.spawn(f, val)
		end
	end
	return obj
end

