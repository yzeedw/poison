local function FixBridge(bridgeModel)
	for _, child in ipairs(bridgeModel:GetChildren()) do
		if child.Name == "PlayerBarrier" and math.floor(child.Rotation.X) == 180 then
			if bridgeModel:FindFirstChild("BridgeBarrier") then continue end
			local bb = child:Clone()
			bb.CFrame = child.CFrame * CFrame.new(0,-7,0)
			bb.Size, bb.Transparency = Vector3.new(40,0.1,40), 0.5
			bb.Color, bb.Material = Color3.fromRGB(128,0,128), Enum.Material.ForceField
			bb.Name, bb.Parent, bb.Anchored, bb.CanCollide = "BridgeBarrier", bridgeModel, true, true
		end
	end
end

local function UpdateBeamVisibility(BeamTable, Visible)
	local Vis = Visible and 0 or 1
	local Seq = NumberSequence.new({NumberSequenceKeypoint.new(0,Vis), NumberSequenceKeypoint.new(1,Vis)})
	for _, Beam in ipairs(BeamTable) do
		if Beam and Beam.Parent then Beam.Transparency = Seq end
	end
end

