local Resetting = false
ResetSection:Button({Name='reset character', Callback=function()
	local function doReset()
		if RemotesFolder:FindFirstChild("Underwater") then
			RemotesFolder.Underwater:FireServer(not Resetting)
			Resetting = not Resetting
		elseif LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.Health = 0
		end
	end
	if typeof(replicatesignal) == "function" then
		pcall(function() replicatesignal(game.Players.LocalPlayer.Kill) end)
		task.wait(2)
		if LocalPlayer:GetAttribute("Alive") ~= false then doReset() end
	else
		doReset()
	end
end})

