					local door = room:FindFirstChild("Door")
					if door and door.PrimaryPart and not isPartInSkippedRoom(door.PrimaryPart) and not ActiveESP[door.PrimaryPart] then
						ApplyESP(door.PrimaryPart, Color3.fromRGB(100,255,100), "door " .. ((tonumber(room.Name) or 0) + 1))
						table.insert(trackedDoors, door.PrimaryPart)
					end
				end
			end
			pcall(findItems, currentRooms)
			pcall(findBooks, currentRooms)
			pcall(findFigure, currentRooms)
			pcall(findWardrobes, currentRooms)
			pcall(findKeys, currentRooms)
			pcall(findLevers, currentRooms)
		end
		if ESPMonsters then
			pruneTracked(trackedMonsters)
			for _, monster in ipairs(Workspace:GetChildren()) do
				if monster:IsA("Model") then
					local mn = getEntityDisplayName(monster.Name)
					if mn then
						if monster.Name == "FigureRig" or monster.Name == "FigureRagdoll" then
							pcall(function()
								local root = monster:FindFirstChild("Root")
								if root then root.Size = Vector3.new(0.001, 0.001, 0.001) end
							end)
						end
						local part = monster.PrimaryPart or monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChild("Hitbox") or monster:FindFirstChildWhichIsA("BasePart")
						if part and not isPartInSkippedRoom(part) and not ActiveESP[part] then
							ApplyESP(part, Color3.fromRGB(255,0,0), mn:lower())
							table.insert(trackedMonsters, part)
						end
					end
				end
			end
		end
		if ESPPlayers then
			pruneTracked(trackedPlayers)
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character and p.Character.PrimaryPart
				and not isPartInSkippedRoom(p.Character.PrimaryPart) and not ActiveESP[p.Character.PrimaryPart] then
					ApplyESP(p.Character.PrimaryPart, Color3.fromRGB(0,255,255), p.Name:lower())
					table.insert(trackedPlayers, p.Character.PrimaryPart)
				end
			end
		end
		task.wait(ESPOptimized and ((ESPOptimizationMethod == "onscreen" or ESPOptimizationMethod == "onScreen") and 0.2 or 0.5) or 1)
	end
end
