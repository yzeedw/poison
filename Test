local function findFigure(currentRooms)
	if not ESPMonsters then if #trackedFigure > 0 then clearTrackedGroup(trackedFigure) end return end
	pruneTracked(trackedFigure)

	local function applyFigureESP(fr)
		if not fr then return end
		pcall(function()
			local root = fr:FindFirstChild("Root")
			if root then root.Size = Vector3.new(0.001, 0.001, 0.001) end
		end)
		local hb = fr:FindFirstChild("Hitbox") or fr.PrimaryPart or fr:FindFirstChild("HumanoidRootPart")
		if hb and hb:IsA("BasePart") and not ActiveESP[hb] then
			ApplyESP(hb, Color3.fromRGB(255,0,0), "figure")
			table.insert(trackedFigure, hb)
		end
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child.Name == "FigureRig" or child.Name == "FigureRagdoll" then
			applyFigureESP(child)
		end
	end

	for _, rn in ipairs({"50","100"}) do
		local room = currentRooms:FindFirstChild(rn)
		if room and (not ESPOptimized or isLatestRoom(room)) then
			local fs = room:FindFirstChild("FigureSetup")
			if fs then
				local fr = fs:FindFirstChild("FigureRig") or fs:FindFirstChild("FigureRagdoll")
				applyFigureESP(fr)
			end
		end
	end
end

