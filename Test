local function CleanupCreakMeter(model)
	local data = CreakMetersTable[model]
	if not data then return end
	CreakMetersTable[model] = nil
	if data.Render then data.Render:Disconnect() end
	if data.Destroy then data.Destroy:Disconnect() end
	for _, dr in ipairs(data.Drawings) do pcall(function() dr:Remove() end) end
end

local function GetCreakAggression(model)
	local anim = model:FindFirstChildOfClass("Animator")
		or (model:FindFirstChild("AnimationController") and model.AnimationController:FindFirstChildOfClass("Animator"))
		or model:FindFirstChildOfClass("AnimationController")
	if not anim then return nil end
	for _, track in ipairs(anim:GetPlayingAnimationTracks()) do
		if track.Name == "CreakGraph" or (track.Animation and track.Animation.Name == "CreakGraph") then
			local ok, val = pcall(track.GetParameter, track, "Aggression")
			if ok and typeof(val) == "number" then return math.clamp(val, 0, 1) end
		end
	end
	return nil
end

local function AddCreakMeter(model)
	if not Toggles.CreakAggressionMeter.Value or model.Name ~= "Creak" or CreakMetersTable[model] then return end
	local head = model:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then return end

	local drawings = {}
	local function create(t)
		local d = Drawing.new(t)
		drawings[#drawings + 1] = d
		return d
	end

	local txt = create("Text")
	txt.Text, txt.Size, txt.Font, txt.Color, txt.Center, txt.Outline, txt.Visible = "Aggression --%", 16, Drawing.Fonts.Plex, Color3.fromRGB(255,255,255), true, true, false
	local bg = create("Square")
	bg.Size, bg.Filled, bg.Color, bg.Transparency, bg.Visible = Vector2.new(112, 6), true, Color3.fromRGB(58,58,64), 0.15, false
	local fill = create("Square")
	fill.Size, fill.Filled, fill.Visible = Vector2.new(0, 6), true, false

	local data = {Drawings = drawings, TitleText = txt, BarBG = bg, BarFill = fill}
	CreakMetersTable[model] = data

	data.Render = RunService.RenderStepped:Connect(function()
		if not Toggles.CreakAggressionMeter.Value or not model.Parent or not head.Parent then
			CleanupCreakMeter(model); return
		end
		CreakAggressionCamera = Workspace.CurrentCamera or CreakAggressionCamera
		if not CreakAggressionCamera then return end
		local pos, visible = CreakAggressionCamera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.85, 0))
		if not (visible and pos.Z > 0) then
			txt.Visible, bg.Visible, fill.Visible = false, false, false; return
		end
		txt.Position = Vector2.new(pos.X, pos.Y - 28)
		bg.Position = Vector2.new(pos.X - 56, pos.Y - 6)
		fill.Position = bg.Position

		local val = GetCreakAggression(model)
		if not val then
			txt.Text, txt.Color = "Aggression --%", Color3.fromRGB(200,200,200)
			txt.Visible, bg.Visible, fill.Visible = true, true, false; return
		end
		txt.Text = "Aggression " .. math.floor(val * 100 + 0.5) .. "%"
		txt.Color = Color3.fromRGB(255,255,255)
		fill.Size = Vector2.new(112 * val, 6)
		fill.Color = Color3.fromRGB(70, 220, 100):Lerp(Color3.fromRGB(255, 55, 55), val)
		txt.Visible, bg.Visible, fill.Visible = true, true, true
	end)

	data.Destroy = model.Destroying:Connect(function() CleanupCreakMeter(model) end)
end

Toggles.CreakAggressionMeter:OnChanged(function(enabled)
	if enabled then
		local live = Workspace:FindFirstChild("LiveEntities")
		if live then
			for _, child in ipairs(live:GetChildren()) do
				if child.Name == "Creak" then AddCreakMeter(child) end
