			for _, anchor in ipairs(minesAnchors) do
				if anchor and anchor.Parent and anchor:FindFirstChild("Sign") and anchor.Sign:FindFirstChild("TextLabel") and anchor.Sign.TextLabel.Text == text then
					local codeText = ahf.Code.Text
					local note = anchor:FindFirstChild("Note")
					local noteText = note and note:FindFirstChild("SurfaceGui") and note.SurfaceGui:FindFirstChild("TextLabel") and note.SurfaceGui.TextLabel.Text or ""
					local noteNum = tonumber(string.match(noteText, "%d+")) or 0
					local solvedCode = ""
					for i = 1, #codeText do
						local cd = tonumber(string.sub(codeText, i, i)) or 0
						local rd = string.find(noteText, "+") and (cd + noteNum) % 10 or (cd - noteNum) % 10
						if rd < 0 then rd += 10 end
						solvedCode ..= tostring(rd)
					end
					local char = LocalPlayer.Character
					if char and char:FindFirstChild("HumanoidRootPart") then
						if (char.HumanoidRootPart.Position - anchor:GetPivot().Position).Magnitude < 20 then
							local rf = anchor:FindFirstChildOfClass("RemoteFunction")
							if rf then rf:InvokeServer(tostring(codeText)) end
							Library:Notification({Text = "anchor " .. solvedCode, Duration = 3})
						end
					end
				end
			end
		end
	end

	if toggles.AutoMinecart.Value and camera:FindFirstChild("MinecartRig") then
		local roomNum = ReplicatedStorage:FindFirstChild("GameData") and ReplicatedStorage.GameData:FindFirstChild("LatestRoom") and ReplicatedStorage.GameData.LatestRoom.Value or 0
		if roomNum < 49 then
			if not LocalPlayer:GetAttribute("NotifyMinecart") then
				Library:Notification({Text = "[auto minecart] don't move", Duration = 5})
				LocalPlayer:SetAttribute("NotifyMinecart", true)
			end
			local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				local minDuckDist = math.huge
				for _, duck in ipairs(duckBoards) do
					if duck and duck.Parent then
						local d = Distance(duck:GetPivot().Position)
						if d < minDuckDist then minDuckDist = d end
					end
				end
				if v15 and typeof(v15) == "table" and v15.crouching ~= nil then v15.crouching = minDuckDist < 30 end
				local targetNode, minNodeDist = nil, math.huge
				for _, node in ipairs(minecartNodes) do
					if node and node.Parent and node:GetAttribute("ForceConnect") then
						local d = (hrp.Position - node.Position).Magnitude
						if d < minNodeDist then minNodeDist, targetNode = d, node end
					end
				end
				if targetNode then
					local nodeNum = tonumber(string.match(targetNode.Name, "%d+"))
					if nodeNum then
						local futureNode
						for _, node in ipairs(minecartNodes) do
							if node.Name == "MinecartNode" .. (nodeNum + 3) then futureNode = node; break end
						end
						if futureNode then
							if Distance(targetNode.Position) > 30 then
								pcall(function()
									require(LocalPlayer.PlayerScripts.PlayerModule):GetControls().GetMoveVector = function()
										return Vector3.new(0,0,-1)
									end
								end)
							else
								local dot = (targetNode.Position - futureNode.Position).Unit:Dot(targetNode.CFrame.RightVector)
								pcall(function()
									require(LocalPlayer.PlayerScripts.PlayerModule):GetControls().GetMoveVector = function()
										return (dot > 0.15 or dot < -0.15) and Vector3.new(1,0,0) or Vector3.new(0,0,-1)
									end
								end)
							end
						end
					end
				end
			end
		elseif roomNum >= 50 then
			if LocalPlayer:GetAttribute("NotifyMinecart") then
				Library:Notification({Text = "[auto minecart] you can move", Duration = 5})
				LocalPlayer:SetAttribute("NotifyMinecart", false)
			end
			toggles.AutoMinecart:SetValue(false)
			pcall(function()
				local controls = require(LocalPlayer.PlayerScripts.PlayerModule):GetControls()
				if originalGetMoveVector then controls.GetMoveVector = originalGetMoveVector end
			end)
		end
	end
end)

local AutoBreaker, AutoBreakerConnection, BreakerBoxFinishedConnection, BreakerMode = false, nil, nil, "instant"

local function EnableBreaker(B)
	if B:GetAttribute("Enabled") == false then
		B:SetAttribute("Enabled", true)
		B.Light.Material = Enum.Material.Neon
		B.Light.Attachment.Spark:Emit(1)
		B.PrismaticConstraint.TargetPosition = -0.2
		B.Sound:Play()
	end
end

local function DisableBreaker(B)
	if B:GetAttribute("Enabled") == true then
		B:SetAttribute("Enabled", false)
		B.Light.Material = Enum.Material.Glass
		B.PrismaticConstraint.TargetPosition = 0.2
		B.Sound:Play()
	end
end

local function SetupBreaker(inst)
	if inst.Name ~= "ElevatorBreaker" then return end
	if AutoBreakerConnection then AutoBreakerConnection:Disconnect(); AutoBreakerConnection = nil end
	local CodeFrame = inst:WaitForChild("SurfaceGui").Frame.Code
	AutoBreakerConnection = CodeFrame:GetPropertyChangedSignal("Text"):Connect(function()
		if not AutoBreaker then return end
		local numeric = tonumber(CodeFrame.Text)
		if BreakerMode == "instant" or BreakerMode == "Instant" then
			if RemotesFolder:FindFirstChild("EBF") then RemotesFolder.EBF:FireServer() end
			return
		end
		if numeric then
			for _, B in ipairs(inst:GetChildren()) do
				if B.Name == "BreakerSwitch" and B:GetAttribute("ID") == numeric then
					if CodeFrame.Frame.BackgroundTransparency == 0 then EnableBreaker(B) else DisableBreaker(B) end
				end
			end
		end
	end)
end
