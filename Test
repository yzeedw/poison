local function getEntityDisplayName(rawName)
	if Entities[rawName] then
		return Entities[rawName].Alias
	end
	local lowerRaw = string.lower(tostring(rawName))
	for key, data in pairs(Entities) do
		local lowerKey = string.lower(key)
		if string.find(lowerRaw, lowerKey, 1, true) or string.find(lowerKey, lowerRaw, 1, true) then
			return data.Alias
		end
	end
	return nil
end

local lastPortraitNotify = 0
local notifiedEntities = setmetatable({}, {__mode = "k"})

local function handleEntitySpawn(entity)
	if not entity or not entity:IsA("Model") then return end
	if entity:GetAttribute("CelestialEntityHandled") then return end
	local entityData = Entities[entity.Name]
	if not entityData then return end
	entity:SetAttribute("CelestialEntityHandled", true)

	task.defer(function()
		if not entity.Parent then return end

		if entity.Name == "FigureRig" or entity.Name == "FigureRagdoll" then
			pcall(function()
				local root = entity:FindFirstChild("Root")
				if root then root.Size = Vector3.new(0.001, 0.001, 0.001) end
			end)
		end

		if _G.NotifyEntity and not notifiedEntities[entity] then
			local canNotify = true
			if entityData.Alias == "Portrait" then
				if tick() - lastPortraitNotify < 10 then
					canNotify = false
				else
					lastPortraitNotify = tick()
				end
			end
			if canNotify then
				notifiedEntities[entity] = true
				entity:SetAttribute("AlreadyNotified", true)
				if entityData.NotifyMessage then
					playAlertSound()
					Library:Notification({
						Text = entityData.NotifyMessage.Title:lower() .. " - " .. entityData.NotifyMessage.Body:lower(),
						Duration = 6
					})
				elseif entityData.Alias then
					playAlertSound()
					Library:Notification({Text = "alert: " .. entityData.Alias:lower() .. " spawned!", Duration = 5})
				end
			end
		end

		if ESPMonsters then
			local part = entity.PrimaryPart
				or entity:FindFirstChild("HumanoidRootPart")
				or entity:FindFirstChild("Hitbox")
				or entity:FindFirstChildWhichIsA("BasePart")
			if part and part:IsA("BasePart") and not ActiveESP[part] then
				ApplyESP(part, Color3.fromRGB(255, 0, 0), entityData.Alias:lower())
				table.insert(trackedMonsters, part)
			end
		end
	end)
end

