			for i = #lootables, 1, -1 do if lootables[i] == x then table.remove(lootables, i); break end end
		end)
		task.spawn(function()
			while _G.AutoLoot do
				for i = #lootables, 1, -1 do
					local x = lootables[i]
					if not x or not x.Parent or not x:IsDescendantOf(workspace) then table.remove(lootables, i); continue end
					if x:IsA("ProximityPrompt") and x.Enabled and table.find(_G.Aura, x.Name)
					and x:GetAttribute("Interactions"..LocalPlayer.Name) == nil and not x:GetAttribute("AlreadyAutoLooted") then
						if x.Parent and x.Parent.Name:find("Mandrake") then continue end
						local tp = x.Parent:IsA("BasePart") and x.Parent.Position or (x.Parent:IsA("Model") and x.Parent:GetPivot().Position)
						if tp and Distance(tp) <= (x.MaxActivationDistance or 10) then
							x:SetAttribute("AlreadyAutoLooted", true); fireproximityprompt(x)
						end
					end
				end
				task.wait(0.3)
			end
		end)
	else
		if ChildAllNext then ChildAllNext:Disconnect(); ChildAllNext = nil end
		if RemoveChild then RemoveChild:Disconnect(); RemoveChild = nil end
	end
end})

