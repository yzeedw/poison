local CreakMeters, CreakCam, CreakConn = {}, Workspace.CurrentCamera, nil
local function CleanupCreak(m)
	local d = CreakMeters[m]; if not d then return end
	CreakMeters[m] = nil
	if d.R then d.R:Disconnect() end
	if d.D then d.D:Disconnect() end
	for _, dr in ipairs(d.Drawings) do pcall(function() dr:Remove() end) end
end
local function GetCreakAgg(m)
	local anim = m:FindFirstChildOfClass("Animator") or (m:FindFirstChild("AnimationController") and m.AnimationController:FindFirstChildOfClass("Animator")) or m:FindFirstChildOfClass("AnimationController")
	if not anim then return nil end
	for _, tr in ipairs(anim:GetPlayingAnimationTracks()) do
		if tr.Name == "CreakGraph" or (tr.Animation and tr.Animation.Name == "CreakGraph") then
			local s, val = pcall(tr.GetParameter, tr, "Aggression")
			if s and typeof(val) == "number" then return math.clamp(val, 0, 1) end
		end
	end
end
local function AddCreakMeter(m)
	if not Toggles.CreakAggressionMeter.Value or m.Name ~= "Creak" or CreakMeters[m] then return end
	local head = m:FindFirstChild("Head"); if not head or not head:IsA("BasePart") then return end
	local txt, bg, fill = Drawing.new("Text"), Drawing.new("Square"), Drawing.new("Square")
	txt.Text, txt.Size, txt.Font, txt.Color, txt.Center, txt.Outline, txt.Visible = "Aggression --%", 16, Drawing.Fonts.Plex, Color3.fromRGB(255,255,255), true, true, false
	bg.Size, bg.Filled, bg.Color, bg.Transparency, bg.Visible = Vector2.new(112, 6), true, Color3.fromRGB(58,58,64), 0.15, false
	fill.Size, fill.Filled, fill.Visible = Vector2.new(0, 6), true, false
	local data = {Drawings = {txt, bg, fill}, TitleText = txt, BarBackground = bg, BarFill = fill}
	CreakMeters[m] = data
	data.R = RunService.RenderStepped:Connect(function()
		if not Toggles.CreakAggressionMeter.Value or not m.Parent or not head.Parent then CleanupCreak(m); return end
		CreakCam = Workspace.CurrentCamera or CreakCam; if not CreakCam then return end
		local pos, vis = CreakCam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.85, 0))
		if not (vis and pos.Z > 0) then txt.Visible, bg.Visible, fill.Visible = false, false, false; return end
		txt.Position, bg.Position = Vector2.new(pos.X, pos.Y - 28), Vector2.new(pos.X - 56, pos.Y - 6)
		fill.Position = bg.Position
		local agg = GetCreakAgg(m)
		if not agg then
			txt.Text, txt.Color, fill.Size, txt.Visible, bg.Visible, fill.Visible = "Aggression --%", Color3.fromRGB(200,200,200), Vector2.new(0,6), true, true, false
			return
		end
		txt.Text = "Aggression " .. math.floor(agg * 100 + 0.5) .. "%"
		txt.Color = Color3.fromRGB(255,255,255)
		fill.Size = Vector2.new(112 * agg, 6)
		fill.Color = Color3.fromRGB(70, 220, 100):Lerp(Color3.fromRGB(255, 55, 55), agg)
		txt.Visible, bg.Visible, fill.Visible = true, true, true
	end)
	data.D = m.Destroying:Connect(function() CleanupCreak(m) end)
end
Toggles.CreakAggressionMeter:OnChanged(function(v)
	if v then
		for _, e in ipairs(Objects.Entities or {}) do AddCreakMeter(e) end
		local live = Workspace:FindFirstChild("LiveEntities")
		if live and live:FindFirstChild("Creak") then AddCreakMeter(live.Creak) end
		if not CreakConn and live then CreakConn = live.ChildAdded:Connect(function(c) if c.Name == "Creak" then AddCreakMeter(c) end end) end
	else
		if CreakConn then CreakConn:Disconnect(); CreakConn = nil end
		for m in pairs(CreakMeters) do CleanupCreak(m) end
	end
end)

