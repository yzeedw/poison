local HighlightPool, BillboardPool, ActiveESP = {}, {}, {}

local function GetPooledHighlight()
	local hl = table.remove(HighlightPool)
	if not hl then
		hl = Instance.new("Highlight")
		hl.Name = "ESPHighlight"
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	end
	return hl
end

local function GetPooledBillboard()
	local bb = table.remove(BillboardPool)
	if not bb then
		bb = Instance.new("BillboardGui")
		bb.Name, bb.Size, bb.StudsOffset, bb.AlwaysOnTop = "ESPBillboard", UDim2.new(0,100,0,20), Vector3.new(0,2.5,0), true
		local tl = Instance.new("TextLabel")
		tl.Name, tl.Size, tl.BackgroundTransparency = "ESPText", UDim2.new(1,0,1,0), 1
		tl.TextSize, tl.Font = 12, Enum.Font.SourceSansBold
		tl.TextStrokeTransparency, tl.TextStrokeColor3 = 0.2, Color3.new(0,0,0)
		tl.Parent = bb
	end
	return bb
end

local function ReleaseESP(part)
	local data = ActiveESP[part]
	if not data then return end
	if data.Highlight then
		local hl = data.Highlight
		hl.Enabled, hl.Adornee, hl.Parent = false, nil, nil
		table.insert(HighlightPool, hl)
	end
	if data.Billboard then
		local bb = data.Billboard
		bb.Enabled, bb.Adornee, bb.Parent = false, nil, nil
		table.insert(BillboardPool, bb)
	end
	ActiveESP[part] = nil
end

local function ApplyESP(part, color, name, showText)
	if not part or not part:IsA("BasePart") or ActiveESP[part] then return end
	showText = showText == nil and true or showText
	local initialVisible = not ESPOptimized or (isPartInLatestRoom(part) and isOnScreen(part))
	local hl = GetPooledHighlight()
	hl.FillColor, hl.OutlineColor = color, color
	hl.FillTransparency, hl.OutlineTransparency = 0.5, 0
	hl.Adornee, hl.Enabled, hl.Parent = part, initialVisible, part
	local bb = nil
	if showText and name and name ~= "" then
		bb = GetPooledBillboard()
		bb.Adornee, bb.Enabled = part, initialVisible
		local tl = bb:FindFirstChild("ESPText")
		if tl then tl.Text, tl.TextColor3 = name:lower(), color end
		bb.Parent = part
	end
	ActiveESP[part] = {Highlight=hl, Billboard=bb}
end

local function updateESPVisibility()
	for part, data in pairs(ActiveESP) do
		if part and part.Parent and part:IsDescendantOf(workspace) then
			local visible = true
			if ESPOptimized then
				visible = isPartInLatestRoom(part) and isOnScreen(part)
			end
			if data.Highlight then data.Highlight.Enabled = visible end
			if data.Billboard then data.Billboard.Enabled = visible end
		else
			ReleaseESP(part)
		end
	end
end

local function clearTrackedGroup(t)
	for _, part in ipairs(t) do if part then ReleaseESP(part) end end
	table.clear(t)
end

local function pruneTracked(t)
	for i = #t, 1, -1 do
		local part = t[i]
		if not part or not part.Parent or not part:IsDescendantOf(workspace) then
			ReleaseESP(part)
			table.remove(t, i)
		end
	end
end

local function Deciphercode(v)
	local Hints = LocalPlayer.PlayerGui:WaitForChild("PermUI"):WaitForChild("Hints")
	local code = {[1]="_",[2]="_",[3]="_",[4]="_",[5]="_"}
	for _, ui in pairs(v:WaitForChild("UI"):GetChildren()) do
		if ui:IsA("ImageLabel") and ui.Name ~= "Image" then
			for _, hint in pairs(Hints:GetChildren()) do
				if hint:IsA("ImageLabel") and hint.Visible and ui.ImageRectOffset == hint.ImageRectOffset then
					code[tonumber(ui.Name)] = hint:FindFirstChild("TextLabel").Text
				end
			end
		end
	end
	return code
end

local function CodeAll(v)
	if v:IsA("Tool") and v.Name == "LibraryHintPaper" then
