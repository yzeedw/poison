local CurrentRooms = Workspace:FindFirstChild("CurrentRooms") or Workspace:WaitForChild("CurrentRooms")
Connections.RoomsHandler = CurrentRooms.ChildAdded:Connect(function(Room)
	for _, obj in ipairs(Globals.RoomsNodesFolder:GetChildren()) do
		if obj.Name == "StuckPart" then obj:Destroy() end
	end
	if Room:GetAttribute("RawName") and string.find(Room:GetAttribute("RawName"), "Eyestalk") then
		local PreviousNode
		local function CreateEyestalkNode(pos)
			local NewNode = Instance.new("Part")
			NewNode.Size, NewNode.Transparency, NewNode.Anchored = Vector3.one, 1, true
			NewNode.Position, NewNode.CanCollide, NewNode.Name = pos, false, "SeekLightNode"
			NewNode.Parent = Globals.SeekNodesFolder
			local PrevNode = PreviousNode or NewNode
			PreviousNode = NewNode
			local NewBeam = Instance.new("Beam")
			NewBeam.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(0,255,0)), ColorSequenceKeypoint.new(1,Color3.fromRGB(0,255,0))})
			NewBeam.FaceCamera, NewBeam.Width0, NewBeam.Width1 = true, 0.2, 0.2
			NewBeam.Brightness, NewBeam.LightInfluence, NewBeam.LightEmission, NewBeam.Enabled = 10, 0, 0, true
			local Vis = Toggles.ShowEyestalkPath and 0 or 1
			NewBeam.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,Vis), NumberSequenceKeypoint.new(1,Vis)})
			NewBeam.Parent = Globals.SeekNodesFolder
			local A0, A1 = Instance.new("Attachment", NewNode), Instance.new("Attachment", PrevNode)
			NewBeam.Attachment0, NewBeam.Attachment1 = A0, A1
			table.insert(Objects.EyestalkHighlights, NewBeam)
		end
		Room:WaitForChild("RoomEntrance", 9e9)
		Room:WaitForChild("RoomExit", 9e9)
		while not Room:GetAttribute("PathFound") do
			if Toggles.ShowEyestalkPath then
				local rp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if rp then
					local EyePath = PathfindingService:CreatePath({AgentCanJump=false,AgentCanClimb=false,WaypointSpacing=2,AgentRadius=1,AgentHeight=1})
					EyePath:ComputeAsync(rp.Position, Room.RoomExit.Position)
					if EyePath.Status == Enum.PathStatus.Success then
						Room:SetAttribute("PathFound", true)
						for _, wp in EyePath:GetWaypoints() do CreateEyestalkNode(wp.Position); task.wait() end
						break
					end
				end
			end
			task.wait(0.25)
		end
	end
end)

