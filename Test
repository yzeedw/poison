local function tryApplyItemESP(desc)
	if not ESPItems or not desc or not desc.Parent then return end
	local itemName = ItemNames[desc.Name]
	if not itemName then return end
	local hasPrompt = desc:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil
		or (desc.Parent and desc.Parent:FindFirstChildWhichIsA("ProximityPrompt"))
		or desc:IsA("Tool")
	if not hasPrompt then return end
	local part = (desc:IsA("BasePart") and desc)
		or (desc:IsA("Model") and (desc.PrimaryPart or desc:FindFirstChild("Handle") or desc:FindFirstChildWhichIsA("BasePart")))
	if part and part:IsA("BasePart") and not ActiveESP[part] then
		ApplyESP(part, Color3.fromRGB(255, 0, 255), itemName:lower())
		table.insert(trackedItems, part)
	end
end

local function setupRoomItemESP(room)
	if not room or itemESPRoomConns[room] then return end
	for _, desc in ipairs(room:GetDescendants()) do
		pcall(tryApplyItemESP, desc)
	end
	itemESPRoomConns[room] = room.DescendantAdded:Connect(function(desc)
		if ESPItems then task.defer(tryApplyItemESP, desc) end
	end)
end

local function teardownRoomItemESP(room)
	if itemESPRoomConns[room] then
		itemESPRoomConns[room]:Disconnect()
		itemESPRoomConns[room] = nil
	end
end

local function teardownAllItemESP()
	for room, conn in pairs(itemESPRoomConns) do
		conn:Disconnect()
	end
	table.clear(itemESPRoomConns)
	clearTrackedGroup(trackedItems)
end

