				notifiedEntities[child] = true
			elseif rawName == "Portrait" or (dispName and dispName:lower() == "portrait") then
				if tick() - lastPortraitNotify < 10 then return end
				lastPortraitNotify = tick()
			end

			if nd then
				playAlertSound()
				Library:Notification({Text = nd[1]:lower() .. ": " .. nd[2]:lower(), Duration = 6})
			elseif dispName then
				playAlertSound()
				Library:Notification({Text = "alert: " .. dispName:lower() .. " spawned!", Duration = 5})
			end
		end)
	else
		if monsterNotifyConn then monsterNotifyConn:Disconnect(); monsterNotifyConn = nil end
	end
})

local function fireRemote(name) if entityInfo:FindFirstChild(name) then entityInfo[name]:FireServer() end end
GameSection:Button({Name="return to lobby", Callback=function() fireRemote("Lobby") end})
GameSection:Button({Name="revive", Callback=function() fireRemote("Revive") end})
GameSection:Button({Name="play again", Callback=function() fireRemote("PlayAgain") end})

MiscSection:Toggle({Name="auto loot", Default=false, Callback=function(v)
	_G.AutoLoot = v
	if v then
		lootables = {}
		local function LootCheck(x)
			if x:IsA("ProximityPrompt") and table.find(_G.Aura, x.Name) then
				table.insert(lootables, x)
			end
		end
		for _, x in ipairs(workspace:GetDescendants()) do LootCheck(x) end
		local conn
		conn = workspace.DescendantAdded:Connect(function(x)
			if _G.AutoLoot then LootCheck(x) else conn:Disconnect() end
		end)
		task.spawn(function()
			while _G.AutoLoot do
				for i = #lootables, 1, -1 do
					local prompt = lootables[i]
					if prompt and prompt.Parent and prompt.Enabled then
						if fireproximityprompt then fireproximityprompt(prompt) end
					else
						table.remove(lootables, i)
					end
				end
				task.wait(0.2)
			end
		end)
	end
end})
