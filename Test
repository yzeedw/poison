local function isOnScreen(part)
	if not part or not part:IsA("BasePart") then return false end
	local _, visible = camera:WorldToViewportPoint(part.Position)
	return visible
end

local function isLatestRoom(room)
	if not room then return true end
	local roomNum = tonumber(room.Name)
	local latestNum = tonumber(LatestRoom.Value) or 0
	if roomNum then
		return roomNum >= latestNum
	end
	return true
end

local function isPartInLatestRoom(part)
	if not part or not part:IsDescendantOf(workspace) then return false end
	local currentRooms = workspace:FindFirstChild("CurrentRooms")
	if not currentRooms then return true end
	if part:IsDescendantOf(currentRooms) then
		local ancestor = part
		while ancestor and ancestor.Parent ~= currentRooms do
			ancestor = ancestor.Parent
		end
		if ancestor then
			return isLatestRoom(ancestor)
		end
	end
	return true
end

if hookmetamethod and newcclosure then
	local old
	old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local args = {...}
		local method = getnamecallmethod()
		if tostring(self) == "ClutchHeartbeat" and method == "FireServer" and ClutchHeart then
			args[2] = true; return old(self, unpack(args))
		end
		if self.Name == "Crouch" and method == "FireServer" and AutoUseCrouch then
			args[1] = true; return old(self, unpack(args))
		end
		if method == "FireServer" then
			if self.Name == "A90" then
				if _G.NoA90 then self:FireServer("didnt"); return end
				if _G.NoA90Damage then args[1] = "didnt"; return old(self, unpack(args)) end
			elseif self.Name == "Screech" and _G.NoScreechDamage then
				local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
				args[1] = not (tool and tool.Name == "Crucifix") ~= nil
				return old(self, unpack(args))
			elseif self.Name == "ShadeResult" and _G.NoHaltDamage then return end
		end
		return old(self, ...)
	end))
end

