    local function updateTogglePos(input)
        local delta = input.Position - tDragStart
        if delta.Magnitude > 5 then hasDragged = true end
        TweenService:Create(outerBorder, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(tStartPos.X.Scale, tStartPos.X.Offset + delta.X, tStartPos.Y.Scale, tStartPos.Y.Offset + delta.Y)
        }):Play()
    end
    toggleButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            tDragging = true; hasDragged = false; tDragStart = input.Position; tStartPos = outerBorder.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then tDragging = false end end)
        end
    end)
    toggleButton.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            tDragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input) if input == tDragInput and tDragging then updateTogglePos(input) end end)

    local function ToggleUI()
        ScreenGui.Enabled = not ScreenGui.Enabled
        if currentMethod == "Default" then
            toggleButton.Text = ScreenGui.Enabled and "−" or "+"
        end
    end
    toggleButton.MouseButton1Click:Connect(function() if not hasDragged then ToggleUI() end end)
    UIS.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then ToggleUI() end
    end)

    function Window:Tab(name)
        local Tab = {}

        local TabButton = Create("TextButton", {
            Name = name,
            Text = "",
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            ZIndex = 4,
            Parent = TabBar,
            ClipsDescendants = true
        })

        local TabText = Create("TextLabel", {
            Name = "Title",
            Text = name,
            Size = UDim2.new(1, -16, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            FontFace = true,
            TextSize = Library.Config.FontSize,
            TextColor3 = Library.Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
