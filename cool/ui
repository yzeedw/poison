function Library:ShowTooltip(text)
    TooltipLabel.Text = text
    TooltipFrame.Visible = true
    if not tooltipConn then
        tooltipConn = game:GetService("RunService").RenderStepped:Connect(function()
            local pos = UIS:GetMouseLocation()
            TooltipFrame.Position = UDim2.new(0, pos.X + 15, 0, pos.Y - 20)
        end)
    end
