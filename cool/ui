function Library:HideTooltip()
    TooltipFrame.Visible = false
    if tooltipConn then 
        tooltipConn:Disconnect()
        tooltipConn = nil
    end
end

local function AddTooltip(inst, text)
    if not text or text == "" then return end
    inst.MouseEnter:Connect(function() Library:ShowTooltip(text) end)
    inst.MouseLeave:Connect(function() Library:HideTooltip() end)
    -- Mobile Support: Close on interact
    inst.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then Library:HideTooltip() end
    end)
end

