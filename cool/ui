            ZIndex = 5,
            Parent = TabButton
        })

        local TabAccent = Create("Frame", {
            Name = "Accent",
            Size = UDim2.new(0, 2, 1, 0),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = Library.Theme.Accent,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 6,
            Parent = TabButton
        })

        Create("Frame", {
            Name = "Border",
            Size = UDim2.new(1, 0, 0, 1),
            Position = UDim2.new(0, 0, 1, -1),
            BackgroundColor3 = Library.Theme.Outline,
            BorderSizePixel = 0,
            ZIndex = 4,
            Parent = TabButton
        })
        
        local TabContent = Create("ScrollingFrame", {
            Name = name .. "Content",
            Size = UDim2.new(1, -12, 1, -12),
            Position = UDim2.new(0, 6, 0, 6),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 2,
            Visible = false,
            ScrollBarThickness = 2,
            ClipsDescendants = true,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Parent = ContentArea
        })

        local LeftColumn = Create("Frame", { Size = UDim2.new(0.5, -6, 1, 0), BackgroundTransparency = 1, Parent = TabContent })
        local RightColumn = Create("Frame", { Size = UDim2.new(0.5, -6, 1, 0), Position = UDim2.new(0.5, 6, 0, 0), BackgroundTransparency = 1, Parent = TabContent })
        
        Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = LeftColumn })
        Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = RightColumn })

        table.insert(Library.Elements.Tabs, { Button = TabButton, Accent = TabAccent, Content = TabContent })

        TabButton.MouseButton1Click:Connect(function()
            for _, t in pairs(Library.Elements.Tabs) do
                t.Content.Visible = false
                t.Accent.Visible = false
                Tween(t.Button, {BackgroundColor3 = Library.Theme.TabBarBackground}, 0.15)
            end
            TabContent.Visible = true
            TabAccent.Visible = true
            Tween(TabButton, {BackgroundColor3 = Library.Theme.Background}, 0.15)
        end)

        function Tab:Section(secName, side)
            local Section = {}
            local col = side:lower() == "left" and LeftColumn or RightColumn

            local SecFrame = Create("Frame", {
                Name = "Section",
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = Library.Theme.DarkBackground,
                BorderSizePixel = 0,
                ZIndex = 3,
                Parent = col
            })
            ApplyCelestiteStyle(SecFrame)

            local SecAccent = Create("Frame", {
                Name = "Accent",
                Size = UDim2.new(1, -2, 0, 2),
                Position = UDim2.new(0, 1, 0, 1),
                BackgroundColor3 = Library.Theme.Accent,
                BorderSizePixel = 0,
                ZIndex = 4,
                Parent = SecFrame
            })

            local SecLabel = Create("TextLabel", {
                Name = "Title",
                Text = secName,
                Size = UDim2.new(1, -12, 0, 24),
                AutomaticSize = Enum.AutomaticSize.Y,
                Position = UDim2.new(0, 6, 0, 3),
                BackgroundTransparency = 1,
                TextSize = Library.Config.FontSize,
                TextColor3 = Library.Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.None,
                ZIndex = 4,
                Parent = SecFrame
            })

            local ElementContainer = Create("Frame", {
                Name = "Elements",
                Size = UDim2.new(1, -12, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Position = UDim2.new(0, 6, 0, 30),
                BackgroundTransparency = 1,
                ZIndex = 4,
                Parent = SecFrame
            })
            Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = ElementContainer })
            Create("UIPadding", { PaddingBottom = UDim.new(0, 6), Parent = ElementContainer })

            table.insert(Library.Elements.Sections, { Frame = SecFrame, Accent = SecAccent })

            function Section:Toggle(opts)
                local state = opts.Default or false
                local Toggle = {}
                
                local Holder = Create("Frame", { 
                    Size = UDim2.new(1, 0, 0, 18), 
                    AutomaticSize = Enum.AutomaticSize.Y, 
                    BackgroundTransparency = 1, 
                    ZIndex = 6, 
                    Parent = ElementContainer 
                })
                
                local Box = Create("Frame", { 
                    Size = UDim2.new(0, 12, 0, 12), 
                    Position = UDim2.new(0, 0, 0.5, -6), 
                    BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.SectionBackground, 
                    ZIndex = 7, 
                    Parent = Holder 
                })
                ApplyCelestiteStyle(Box)
                
                local Label = Create("TextLabel", { 
                    Text = opts.Name or "Toggle", 
                    Size = UDim2.new(1, -75, 0, 18), 
                    AutomaticSize = Enum.AutomaticSize.Y, 
                    Position = UDim2.new(0, 18, 0, 0), 
                    BackgroundTransparency = 1, 
                    TextXAlignment = Enum.TextXAlignment.Left, 
                    TextYAlignment = Enum.TextYAlignment.Center,
                    TextWrapped = true,
                    TextTruncate = Enum.TextTruncate.None,
                    ZIndex = 7, 
                    Parent = Holder 
                })
                
                AddTooltip(Holder, opts.Tooltip)

                local btn = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 8, Parent = Holder })

                local function Update()
                    Tween(Box, {BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.SectionBackground}, 0.15)
                    if opts.Callback then opts.Callback(state) end
                end

                btn.MouseButton1Click:Connect(function()
                    state = not state
                    Update()
                end)

                if opts.Flag then Library.Flags[opts.Flag] = { Get = function() return state end, Set = function(v) state = v; Update() end } end
                table.insert(Library.Elements.Toggles, { Box = Box, GetState = function() return state end })
                return Toggle
            end
            
            function Section:Dropdown(opts)
                local isMulti = opts.Multi or false
                local selected = opts.Default or (isMulti and {} or (opts.Options[1] or "None"))
                local options = opts.Options or {}
                local dropped = false
                
                local Holder = Create("Frame", { Name = "DropdownHolder", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 6, Parent = ElementContainer })
                Create("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = Holder})
                
                local Label = Create("TextLabel", { 
                    Text = opts.Name or "Dropdown", 
                    Size = UDim2.new(1, 0, 0, 14), 
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundTransparency = 1, 
                    TextXAlignment = Enum.TextXAlignment.Left, 
                    TextWrapped = true,
                    ZIndex = 7, 
                    Parent = Holder 
                })
                
                local Box = Create("Frame", { Name = "DropdownBox", Size = UDim2.new(1, 0, 0, 20), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Library.Theme.SectionBackground, ZIndex = 7, Parent = Holder })
                ApplyCelestiteStyle(Box)
                Create("UIPadding", {PaddingTop=UDim.new(0,3), PaddingBottom=UDim.new(0,3), Parent=Box})

                local function GetMultiString(tbl)
                    if type(tbl) ~= "table" then return "None" end
                    local strTbl = {}
                    for _, v in ipairs(tbl) do table.insert(strTbl, tostring(v)) end
                    return table.concat(strTbl, ", ")
                end

                local ValueLabel = Create("TextLabel", { 
                    Text = isMulti and (#selected > 0 and GetMultiString(selected) or "None") or tostring(selected), 
                    Size = UDim2.new(1, -20, 0, 14), 
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Position = UDim2.new(0, 6, 0, 0), 
                    BackgroundTransparency = 1, 
                    TextXAlignment = Enum.TextXAlignment.Left, 
                    TextYAlignment = Enum.TextYAlignment.Center,
                    TextWrapped = true,
                    ZIndex = 8, 
                    Parent = Box 
                })
                
                local Arrow = Create("TextLabel", { Text = "v", Size = UDim2.new(0, 15, 1, 0), Position = UDim2.new(1, -15, 0, 0), BackgroundTransparency = 1, ZIndex = 8, Parent = Box })
                local Button = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 9, Parent = Box })

                AddTooltip(Holder, opts.Tooltip)

                local DropContainer = Create("ScrollingFrame", { 
                    Name = "DropContainer", 
                    BackgroundColor3 = Library.Theme.DarkBackground, 
                    BorderSizePixel = 0, 
                    Visible = false, 
                    ZIndex = 5000, 
                    Parent = ScreenGui, 
                    ClipsDescendants = true,
                    ScrollBarThickness = 2
                })
                ApplyCelestiteStyle(DropContainer)
                local DropList = Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = DropContainer })

                local dropElementData = { Box = Box, Container = DropContainer, Buttons = {} }

                local function UpdateList(newOptions)
                    if newOptions then options = newOptions end
                    for _, v in pairs(DropContainer:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
                    dropElementData.Buttons = {}
                    
                    local h2 = math.clamp((#options == 0 and 1 or #options) * 18, 18, 160)
                    DropContainer.CanvasSize = UDim2.new(0, 0, 0, #options * 18)

                    for _, option in ipairs(options) do
                        local isSelected = isMulti and table.find(selected, option) ~= nil or (option == selected)
                        
                        local optBtn = Create("TextButton", {
                            Text = tostring(option),
                            Size = UDim2.new(1, 0, 0, 18),
                            BackgroundColor3 = Library.Theme.DarkBackground,
                            BorderSizePixel = 0,
                            TextColor3 = isSelected and Library.Theme.Accent or Library.Theme.Text,
                            TextWrapped = true,
                            ZIndex = 5001,
                            Parent = DropContainer
                        })
                        table.insert(dropElementData.Buttons, optBtn)
                        table.insert(Library.Elements.AllTextObjects, optBtn)
                        
                        optBtn.MouseButton1Click:Connect(function()
                            if isMulti then
                                if isSelected then
                                    table.remove(selected, table.find(selected, option))
                                else
                                    table.insert(selected, option)
                                end
                                UpdateList()
                            else
                                selected = option
                                dropped = false
                                DropContainer.Visible = false
                                Arrow.Text = "v"
                                UpdateList()
                            end
                            if opts.Callback then opts.Callback(selected) end
                        end)
                    end
                    
                    if isMulti then
                        ValueLabel.Text = type(selected) == "table" and #selected > 0 and GetMultiString(selected) or "None"
                    else
                        ValueLabel.Text = tostring(selected)
                    end
                end

                dropElementData.UpdateVisuals = function() UpdateList() end
                table.insert(Library.Elements.Dropdowns, dropElementData)
                UpdateList()

                Button.MouseButton1Click:Connect(function()
                    dropped = not dropped
                    if dropped then
                        local h2 = math.clamp((#options == 0 and 1 or #options) * 18, 18, 160)
                        task.defer(function()
                            DropContainer.Position = UDim2.new(0, Box.AbsolutePosition.X, 0, Box.AbsolutePosition.Y + Box.AbsoluteSize.Y + 2)
                            DropContainer.Size = UDim2.new(0, Box.AbsoluteSize.X, 0, h2)
                            DropContainer.Visible = true
                            Arrow.Text = "^"
                        end)
                    else
                        DropContainer.Visible = false
                        Arrow.Text = "v"
                    end
                end)
                
                UIS.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        if dropped and not IsWithin(DropContainer, input) and not IsWithin(Box, input) then
                            dropped = false; DropContainer.Visible = false; Arrow.Text = "v"
                        end
                    end
                end)

                local Obj = {
                    Get = function() return selected end,
                    Set = function(v)
                        selected = v
                        UpdateList()
                        if opts.Callback then opts.Callback(v) end
                    end,
                    Refresh = function(self, newOptions) UpdateList(newOptions) end
                }
                if opts.Flag then Library.Flags[opts.Flag] = Obj end
                return Obj
            end
            
            -- Adding Tooltips natively mapped to generic elements as well
            function Section:Button(opts)
                local Holder = Create("Frame", { Size = UDim2.new(1, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 6, Parent = ElementContainer })
                local Box = Create("Frame", { Size = UDim2.new(1, 0, 0, 22), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Library.Theme.SectionBackground, ZIndex = 7, Parent = Holder })
                ApplyCelestiteStyle(Box)
                Create("UIPadding", {PaddingTop=UDim.new(0,4), PaddingBottom=UDim.new(0,4), Parent=Box})
                
                local Label = Create("TextLabel", { Text = opts.Name or "Button", Size = UDim2.new(1, -10, 0, 14), AutomaticSize = Enum.AutomaticSize.Y, Position = UDim2.new(0, 5, 0, 0), BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = true, ZIndex = 8, Parent = Box })
                local btn = Create("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 9, Parent = Box })
                
                AddTooltip(Holder, opts.Tooltip)
                table.insert(Library.Elements.Buttons, Box)
                btn.MouseButton1Click:Connect(function() if opts.Callback then opts.Callback() end end)
            end

            return Section
        end
        
        function Tab:Themes(side) 
            local s = Tab:Section("Themes", side)
            s:Button({Name = "Refresh Themes", Tooltip = "Refreshes your custom themes", Callback = function() print("Refresh Themes") end}) 
        end
        function Tab:Configs(side) 
            local s = Tab:Section("Configs", side) 
            s:Button({Name = "Save Config", Tooltip = "Saves your current configuration locally", Callback = function() print("Saved!") end}) 
        end

        return Tab
    end

    if #Library.Elements.Tabs > 0 then
        Library.Elements.Tabs[1].Content.Visible = true
        Library.Elements.Tabs[1].Accent.Visible = true
        Library.Elements.Tabs[1].Button.BackgroundColor3 = Library.Theme.Background
    end

    return Window
end
